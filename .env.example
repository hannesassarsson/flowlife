# --- Supabase ---
# Project URL, same for both client and server.
NEXT_PUBLIC_SUPABASE_URL=

# Current key naming (sb_publishable_xxx / sb_secret_xxx). Legacy
# anon/service_role keys are deprecated end of 2026 but still work during
# the migration window — lib/supabase/client.ts and server.ts fall back to
# the *_ANON_KEY / *_SERVICE_ROLE_KEY names below if the new ones are unset.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy fallback names (remove once fully migrated to the keys above):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Multi-tenancy ---
# Root domain for subdomain-based tenant routing. company.{this} resolves
# to that company's portal. No protocol, no trailing slash.
NEXT_PUBLIC_ROOT_DOMAIN=yourapp.se

# --- Integrations (Phase 2 / future modules) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
